# Gemini API Key (Required for AI Editorial Evaluation)
GEMINI_API_KEY=

# Scheduler Interval in Minutes (Default: 2)
SCHEDULER_INTERVAL_MINUTES=2

# Maximum articles discovered per cycle (Default: 10)
MAX_ARTICLES_PER_CYCLE=10

# Maximum articles evaluated by Gemini per cycle (Default: 3)
MAX_GEMINI_ARTICLES=3

# Optional: Force deterministic fallback engine for testing
FORCE_FALLBACK=false

# Optional: Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
